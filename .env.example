# ========================================================
# .env.example — Variables de entorno del proyecto
# Copia este archivo como .env y completa los valores reales
# NUNCA subas el archivo .env real a GitHub
# ========================================================

# ─── Base de datos PostgreSQL ─────────────────────────────
DATABASE_URL=postgresql://hackathon:hackathon123@localhost:5432/educacion_gt

# ─── API de IA (Claude / Anthropic) ──────────────────────
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── CORS (origins permitidos para el frontend) ───────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Variables del frontend (Vite) ───────────────────────
# URL base del backend desde el navegador
VITE_API_URL=http://localhost:8000
