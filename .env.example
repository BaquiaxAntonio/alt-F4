# ==========================================
# Archivo de Entorno de Ejemplo (.env.example)
# ==========================================
# INSTRUCCIONES: Copia este archivo, renómbralo a '.env' 
# y reemplaza los valores por tus credenciales reales.
# ESTE ARCHIVO SÍ SE SUBE AL REPOSITORIO (no contiene secretos reales).

# --------------------------
# 1. Inteligencia Artificial
# --------------------------
# API Key de Anthropic (Claude) o OpenAI
CLAUDE_API_KEY="tu_api_key_de_claude_aqui"
# OPENAI_API_KEY="tu_api_key_de_openai_aqui"

# --------------------------
# 2. Base de Datos
# --------------------------
# Para desarrollo local rápido, pueden usar SQLite (creará un archivo local)
DATABASE_URL="sqlite:///./hackathon_data.db"
# Si usan PostgreSQL, sería algo como esto:
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/educacion_db"

# --------------------------
# 3. Backend (FastAPI)
# --------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"

# --------------------------
# 4. Frontend (Next.js/React)
# --------------------------
# Next.js requiere el prefijo NEXT_PUBLIC_ para exponer variables al navegador
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
